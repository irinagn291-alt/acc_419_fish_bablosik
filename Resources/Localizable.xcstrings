    "Choose a gentle prompt to record your catch or prepare for the weekend. Notifications are requested only when you enable a reminder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a gentle prompt to record your catch or prepare for the weekend. Notifications are requested only when you enable a reminder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Erinnerung für dein Tagebuch oder das Wochenende. Die Erlaubnis wird erst beim Aktivieren angefragt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un rappel pour vos prises ou le week-end. L’autorisation est demandée uniquement à l’activation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un aviso para registrar capturas o preparar el fin de semana. El permiso se solicita al activar un recordatorio."
          }
        }
      }
    },
