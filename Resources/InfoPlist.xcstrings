{
  "sourceLanguage": "en",
  "strings": {
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the fishing point and fetch weather for that point when you choose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere deinen Angelplatz und rufe auf Wunsch das Wetter dort ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez le lieu de pêche et récupérez sa météo si vous le souhaitez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el punto de pesca y consulta su tiempo cuando lo elijas."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph your catch to keep the image with a journal entry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere deinen Fang, um das Bild im Tagebuch zu behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographiez votre prise pour la conserver dans le carnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografía tu captura para guardarla en una entrada."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a catch photo to attach to your private fishing journal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Fangfoto für dein privates Angeltagebuch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une photo de prise pour votre carnet privé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una foto de captura para tu diario privado."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a designed catch card in Photos when you tap Save card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere eine gestaltete Fangkarte in Fotos, wenn du dies auswählst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez une fiche de prise dans Photos à votre demande."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una ficha de captura en Fotos cuando lo solicites."
          }
        }
      }
    }
  },
  "version": "1.0"
}