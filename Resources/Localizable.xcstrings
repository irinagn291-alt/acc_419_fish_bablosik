    "Enter latitude −90…90 and longitude −180…180, or leave both empty.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter latitude −90…90 and longitude −180…180, or leave both empty."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breite −90…90 und Länge −180…180 eingeben oder beide Felder leer lassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une latitude de −90 à 90 et une longitude de −180 à 180, ou laissez les deux vides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce latitud de −90 a 90 y longitud de −180 a 180, o deja ambos campos vacíos."
