    "Edit and save with online weather enabled to retry for this entry’s date.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit and save with online weather enabled to retry for this entry’s date."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeite und speichere mit aktiviertem Online-Wetter, um das Wetter erneut abzurufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez et enregistrez avec la météo en ligne activée pour réessayer à cette date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita y guarda con el tiempo en línea activado para volver a consultar esa fecha."
